# ============================== Guard AI API ==============================
# Render: set these on the service (render.yaml lists them). Locally: copy to .env and run
#   uvicorn app.main:app --reload --port 8000 --env-file .env

# ---- Database (Neon Postgres, free) ------------------------------------------
# neon.tech -> your project -> Connect -> copy the *pooled* connection string (host contains "-pooler").
# Leave commented out locally to use a SQLite file (guardai_dev.db). Migrations run automatically on startup.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Clerk -----------------------------------------------------------------
# Dashboard -> API keys. Issuer = "Frontend API URL". The secret key lets proctors create student
# accounts and send invitations; enable "Email address" + "Password" sign-in in Clerk for created accounts.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_xxx

# ---- Web ---------------------------------------------------------------------
# Comma-separated frontend origins (your Vercel URL + local dev). FRONTEND_URL is used in invite emails.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- File storage: any S3-compatible bucket (evidence snapshots + reference photos) ----
# Backblaze B2 (10 GB free, no card): Buckets -> Create a Bucket (Private) -> note its Endpoint, e.g.
#   s3.us-west-004.backblazeb2.com (region = us-west-004). Application Keys -> Add a New Application Key with
#   Read and Write access to that bucket: keyID -> S3_ACCESS_KEY_ID, applicationKey -> S3_SECRET_ACCESS_KEY.
# Cloudflare R2 works too (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto, or set R2_*).
# Leave empty locally to store files in ./uploads.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=guardai-evidence
# (Alternative: Supabase Storage via SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + SUPABASE_BUCKET.)

# ---- Live video (WebRTC, peer to peer) --------------------------------------
# Works with the built-in STUN servers on most networks. Strict networks (some colleges/offices/mobile) need a
# TURN relay: Cloudflare Realtime -> TURN -> create a key (free tier). Or a static TURN server via TURN_URLS etc.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---- AI proctoring -----------------------------------------------------------
# Frames analysed in parallel (1 vCPU -> 1-2). Base frame interval; raised automatically under load.
ML_CONCURRENCY=2
FRAME_INTERVAL_MS=1000
# ML_ENABLED=false   # run the API without the vision models (proctoring analysis disabled)

# ---- Teacher assistant (Groq) ------------------------------------------------
# console.groq.com -> API Keys. Powers the chat assistant in the proctor panel.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b   # used automatically when the main model is rate limited

# ---- Email: branded student invitations + contact form -----------------------
# Brevo (free 300/day, no domain needed): brevo.com -> Senders, Domains & Dedicated IPs -> add and verify your
# email address as a sender; SMTP & API -> API keys -> generate. EMAIL_FROM must be that verified address.
# Resend works too (needs a verified domain). Without either, Clerk sends its own invitation email.
# (Render's free plan blocks SMTP, so these HTTPS APIs are the only way to send from it.)
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Guard AI <you@gmail.com>
CONTACT_TO=you@example.com

# ---- LOCAL DEVELOPMENT ONLY: trust "X-Dev-User: <id>" headers instead of Clerk tokens
DEV_AUTH=false
